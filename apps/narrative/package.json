{
  "name": "@sniperbot/narrative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Narrative scorer: rates every new launch against the current memecoin metas and writes narrative:<mint> to Redis for the engine's narrative filter",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "report": "tsx scripts/report.ts",
    "score": "tsx scripts/score-once.ts"
  },
  "dependencies": {
    "@sniperbot/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "p-queue": "^9.2.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
