generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mode {
  paper
  live
}

enum DexSource {
  pumpfun
  pumpswap
  raydium_amm
  raydium_clmm
  raydium_launchpad
  meteora
  orca
}

enum PositionStatus {
  open
  partial
  closed
}

enum TradeSide {
  buy
  sell
}

enum TradeStatus {
  filled
  failed
  partial
}

// Every pool the engine has detected, regardless of decision.
model Pool {
  id                   String     @id @default(cuid())
  poolAddress          String     @unique
  tokenMint            String
  baseMint             String
  source               DexSource
  initialLiquidityUsd  Float
  initialPriceUsd      Float
  creatorWallet        String
  detectedAt           DateTime
  signature            String
  rawEvent             Json?

  positions            Position[]

  @@index([detectedAt])
  @@index([creatorWallet])
  @@index([source])
}

// The strategy's decision on a pool: "buy" or "skip", with its reason.
model PoolDecision {
  id              String   @id @default(cuid())
  poolAddress     String   @unique
  decision        String
  decisionReason  String
  decidedAt       DateTime

  @@index([decidedAt])
  @@index([decision])
}

// Open or closed position (paper or live).
model Position {
  id                 String         @id @default(cuid())
  pool               Pool           @relation(fields: [poolId], references: [id])
  poolId             String
  tokenMint          String
  mode               Mode
  entryPriceUsd      Float
  entrySizeUsd       Float
  tokensHeld         Float
  currentPriceUsd    Float
  unrealizedPnlUsd   Float          @default(0)
  realizedPnlUsd     Float          @default(0)
  peakPriceUsd       Float
  peakGainPct        Float          @default(0)
  status             PositionStatus @default(open)
  openedAt           DateTime
  closedAt           DateTime?
  closeReason        String?

  trades             Trade[]

  @@index([status])
  @@index([openedAt])
  @@index([mode])
  @@index([closeReason])
}

// Every buy/sell tx (paper or live).
model Trade {
  id              String       @id @default(cuid())
  position        Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  positionId      String
  side            TradeSide
  status          TradeStatus
  priceUsd        Float
  amountTokens    Float
  amountUsd       Float
  feeSol          Float
  slippagePct     Float
  mevPenaltyPct   Float?
  exitReason      String?
  signature       String?
  executedAt      DateTime

  @@index([positionId])
  @@index([executedAt])
}

// Snapshots of bankroll PnL for dashboard charts.
model BankrollSnapshot {
  id           String   @id @default(cuid())
  mode         Mode
  balanceUsd   Float
  realizedPnl  Float
  openExposure Float
  positionCnt  Int
  takenAt      DateTime @default(now())

  @@index([mode, takenAt])
}
