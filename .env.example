# =====================================================
# MODE — paper trading is the default. NEVER ship live.
# =====================================================
MODE=paper
ENABLE_LIVE_TRADING=false

# =====================================================
# SOLANA RPC (get free key at helius.dev)
# =====================================================
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=
TRITON_RPC_URL=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Requests per second the engine sends to the RPC, across everything. Keep it
# under your plan's limit (Helius free allows 10) so bursts wait instead of
# failing with 429 Too Many Requests.
RPC_MAX_RPS=8

# Free fallbacks (no key needed) for when Helius isn't configured.
PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
JUPITER_QUOTE_API=https://lite-api.jup.ag/swap/v1
# Market prices for paper trades (entries and open positions). Free, keyless.
JUPITER_PRICE_API=https://lite-api.jup.ag/price/v3
RUGCHECK_API_BASE=https://api.rugcheck.xyz/v1

# =====================================================
# DATA APIS
# =====================================================
BIRDEYE_API_KEY=
BITQUERY_API_KEY=
RUGCHECK_API_KEY=
DEXSCREENER_BASE=https://api.dexscreener.com
GECKOTERMINAL_BASE=https://api.geckoterminal.com/api/v2

# =====================================================
# WALLET (live mode only — leave empty for paper)
# =====================================================
SOLANA_KEYPAIR_PATH=
WALLET_PUBKEY=

# =====================================================
# BANKROLL
# =====================================================
PAPER_STARTING_BALANCE_USD=10000
LIVE_MAX_BANKROLL_USD=500

# =====================================================
# EXECUTION
# =====================================================
JITO_TIP_LAMPORTS=10000
JITO_TIP_DYNAMIC=true
SLIPPAGE_BPS=300
PRIORITY_FEE_MICROLAMPORTS=100000

# =====================================================
# DEX SOURCES
# =====================================================
ENABLE_PUMPFUN=true
# Drop pump.fun Mayhem Mode coins (an AI agent trades them for 24h) and coins
# paired with USDC or another pump coin instead of SOL. Both are read from the
# launch's own logs, so dropping them costs no RPC credit.
PUMPFUN_SKIP_MAYHEM=true
PUMPFUN_SOL_PAIRS_ONLY=true
ENABLE_PUMPSWAP=true
ENABLE_RAYDIUM_AMM=true
ENABLE_RAYDIUM_CLMM=false
ENABLE_RAYDIUM_LAUNCHPAD=true
ENABLE_METEORA=false
ENABLE_ORCA=false

# =====================================================
# INFRASTRUCTURE
# =====================================================
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sniperbot

# =====================================================
# ALERTS — Telegram. Off until both values are set.
# Token: message @BotFather, /newbot. Chat id: leave it empty, press Start
# in a chat with your bot, then `pnpm alerts:test` lists the id to paste here.
# =====================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_NEW_POSITION=true
ALERT_ON_EXIT=true
ALERT_ON_DAILY_PNL=true
# "engine online" at boot, "engine stopping" at shutdown. Turn off while
# running `pnpm dev`, which restarts on every save.
ALERT_ON_ENGINE_STATUS=true
# Hour (UTC) the daily report is sent. 0 = 00:00 UTC = 05:30 IST.
ALERT_DAILY_PNL_HOUR_UTC=0

# =====================================================
# RUNTIME
# =====================================================
LOG_LEVEL=info
NODE_ENV=development
ENGINE_HTTP_PORT=4000
DASHBOARD_PORT=3000
