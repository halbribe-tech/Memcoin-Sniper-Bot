# =====================================================
# MODE — paper trading is the default. NEVER ship live.
# =====================================================
MODE=paper
ENABLE_LIVE_TRADING=false

# =====================================================
# SOLANA RPC (get free key at helius.dev)
# =====================================================
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=
TRITON_RPC_URL=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Requests per second the engine sends to the RPC, across everything. Keep it
# under your plan's limit (Helius free allows 10) so bursts wait instead of
# failing with 429 Too Many Requests.
RPC_MAX_RPS=8

# Free fallbacks (no key needed). Filters use these when Helius isn't configured.
PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
JUPITER_QUOTE_API=https://lite-api.jup.ag/swap/v1
# Market prices for paper trades (entries, exits, rug watch). Free, keyless.
JUPITER_PRICE_API=https://lite-api.jup.ag/price/v3
RUGCHECK_API_BASE=https://api.rugcheck.xyz/v1

# =====================================================
# DATA APIS
# =====================================================
BIRDEYE_API_KEY=
BITQUERY_API_KEY=
RUGCHECK_API_KEY=
DEXSCREENER_BASE=https://api.dexscreener.com
GECKOTERMINAL_BASE=https://api.geckoterminal.com/api/v2

# =====================================================
# WALLET (live mode only — leave empty for paper)
# =====================================================
SOLANA_KEYPAIR_PATH=
WALLET_PUBKEY=

# =====================================================
# BANKROLL
# =====================================================
PAPER_STARTING_BALANCE_USD=10000
LIVE_MAX_BANKROLL_USD=500

# =====================================================
# POSITION SIZING
# =====================================================
POSITION_SIZE_PCT=1.0
MAX_CONCURRENT_POSITIONS=10
MAX_TOTAL_EXPOSURE_PCT=30
MAX_POSITION_PER_MIN=3

# =====================================================
# EXITS
# =====================================================
TP_LADDER=50:25,100:25,300:25,900:15
STOP_LOSS_PCT=-40
TRAILING_STOP_PCT=30
TRAILING_STOP_ACTIVATION_PCT=200
# Once TP1 has sold, the stop on the rest moves up to the entry price.
BREAKEVEN_AFTER_TP1=true
# Sell whatever is left this many minutes after the buy, win or lose. 0 = off.
HARD_EXIT_MIN=0
# A pump.fun curve cannot fall below its start price. A coin sitting within
# DEAD_COIN_MAX_GAIN_PCT of it for DEAD_COIN_EXIT_MIN minutes has been sold
# back by everyone: its loss is already fixed, so it is sold to free the slot
# instead of waiting for the time exit. 0 minutes turns this off.
DEAD_COIN_EXIT_MIN=3
DEAD_COIN_MAX_GAIN_PCT=2
TIME_EXIT_MIN=30
RUG_DETECTION_LP_DROP_PCT=30

# =====================================================
# RISK
# =====================================================
DAILY_DRAWDOWN_LIMIT_PCT=10
WEEKLY_DRAWDOWN_LIMIT_PCT=25
HALT_ON_CONSECUTIVE_LOSSES=20

# =====================================================
# FILTERS — every threshold tunable
# =====================================================
# Seconds between a pool appearing and its filters running. At launch the
# honeypot quote, volume and socials do not exist yet; 0 judges at once.
EVAL_DELAY_SEC=90
# How pump.fun launches are entered. "delay" judges each launch EVAL_DELAY_SEC
# after it appears. "breakout" judges it the moment its curve first reaches
# BREAKOUT_MULTIPLE x its start price, at least BREAKOUT_MIN_AGE_SEC after the
# create, with BREAKOUT_MIN_BUY_SOL of buying and a dev who has sold less than
# BREAKOUT_MAX_DEV_SOLD_PCT of their buy. Pair it with the Breakout preset.
ENTRY_MODE=delay
BREAKOUT_MULTIPLE=2
BREAKOUT_MIN_AGE_SEC=5
BREAKOUT_MIN_BUY_SOL=22
BREAKOUT_MAX_DEV_SOLD_PCT=100
FILTER_LIQUIDITY_MIN_USD=5000
FILTER_LIQUIDITY_MAX_USD=500000
FILTER_LP_LOCKED_REQUIRED=true
FILTER_MINT_AUTH_RENOUNCED=true
FILTER_FREEZE_AUTH_RENOUNCED=true
FILTER_TOP_HOLDER_MAX_PCT=15
FILTER_TOP_10_HOLDERS_MAX_PCT=35
FILTER_DEV_RUG_RATE_MAX=0.30
FILTER_HONEYPOT_SIM_REQUIRED=true
FILTER_MAX_SELL_TAX_PCT=10
FILTER_BUNDLED_LAUNCH_REJECT=true
# pump.fun: reject when the wallets that bought in the launch slot (dev
# excluded) still hold this % of supply or more, or when the dev has already
# sold this % of their own buy. Read from the log stream, no RPC cost.
FILTER_BUNDLE_MAX_SUPPLY_PCT=15
FILTER_DEV_MAX_SOLD_PCT=50
# pump.fun only: % the price must sit above its launch price when the filters
# run, the launch price being the curve after the dev's own buy in the create
# transaction. Under 20% over the start, 2% of launches went on to reach TP1;
# at 20% and over, 12%.
FILTER_CURVE_GAIN_MIN_PCT=20
FILTER_MIN_FILTER_SCORE=70

# =====================================================
# EXECUTION
# =====================================================
JITO_TIP_LAMPORTS=10000
JITO_TIP_DYNAMIC=true
SLIPPAGE_BPS=300
PRIORITY_FEE_MICROLAMPORTS=100000

# =====================================================
# DEX SOURCES
# =====================================================
ENABLE_PUMPFUN=true
# Drop pump.fun Mayhem Mode coins (an AI agent trades them for 24h) and coins
# paired with USDC or another pump coin instead of SOL. Both are read from the
# launch's own logs, so dropping them costs no RPC credit.
PUMPFUN_SKIP_MAYHEM=true
PUMPFUN_SOL_PAIRS_ONLY=true
ENABLE_PUMPSWAP=true
ENABLE_RAYDIUM_AMM=true
ENABLE_RAYDIUM_CLMM=false
ENABLE_RAYDIUM_LAUNCHPAD=true
ENABLE_METEORA=false
ENABLE_ORCA=false

# =====================================================
# INFRASTRUCTURE
# =====================================================
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sniperbot

# =====================================================
# ALERTS — Telegram. Off until both values are set.
# Token: message @BotFather, /newbot. Chat id: leave it empty, press Start
# in a chat with your bot, then `pnpm alerts:test` lists the id to paste here.
# =====================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_NEW_POSITION=true
ALERT_ON_EXIT=true
ALERT_ON_DAILY_PNL=true
ALERT_ON_DRAWDOWN_HALT=true
# "engine online" at boot, "engine stopping" at shutdown. Turn off while
# running `pnpm dev`, which restarts on every save.
ALERT_ON_ENGINE_STATUS=true
# Hour (UTC) the daily report is sent. 0 = 00:00 UTC = 05:30 IST.
ALERT_DAILY_PNL_HOUR_UTC=0

# =====================================================
# RUNTIME
# =====================================================
LOG_LEVEL=info
NODE_ENV=development
ENGINE_HTTP_PORT=4000
DASHBOARD_PORT=3000

# Generate fake launches (rugs included) instead of reading Helius — runs the
# whole pipeline with no API key.
SYNTHETIC_FEED=false
SYNTHETIC_FEED_MIN_MS=2000
SYNTHETIC_FEED_MAX_MS=5000

# =====================================================
# NARRATIVE FILTER (engine) — shadow = recorded only, never changes a verdict
# =====================================================
NARRATIVE_FILTER_MODE=shadow
NARRATIVE_FILTER_WEIGHT=0
NARRATIVE_MIN_SCORE=50

# =====================================================
# NARRATIVE SCORER (apps/narrative) — reads REDIS_URL / DATABASE_URL above
# =====================================================
NARRATIVE_TTL_SEC=1800
# local meta list, reloaded on change (path relative to the repo root)
NARRATIVE_METAS_FILE=apps/narrative/data/metas.json
# optional remote meta list, polled every NARRATIVE_METAS_POLL_SEC
NARRATIVE_METAS_URL=
NARRATIVE_METAS_URL_TOKEN=
NARRATIVE_METAS_POLL_SEC=300
NARRATIVE_FRESHNESS_HALFLIFE_H=24
# fallback metas from the bot's own recent winners (Postgres)
NARRATIVE_SELF_SOURCE=true
NARRATIVE_SELF_LOOKBACK_H=6
NARRATIVE_SELF_MIN_GAIN_PCT=100
NARRATIVE_SELF_REFRESH_SEC=300
NARRATIVE_SATURATION_FREE=8
NARRATIVE_METADATA_TIMEOUT_MS=4000
NARRATIVE_METADATA_CONCURRENCY=16
# LLM (any OpenAI-compatible endpoint); off while API key or model is empty
NARRATIVE_LLM_BASE_URL=https://api.openai.com/v1
NARRATIVE_LLM_API_KEY=
NARRATIVE_LLM_MODEL=
NARRATIVE_LLM_MIN_FAST_SCORE=45
NARRATIVE_LLM_WEIGHT=0.4
NARRATIVE_LLM_TIMEOUT_MS=8000
NARRATIVE_LLM_MAX_PER_MIN=20
NARRATIVE_LLM_CONCURRENCY=3
